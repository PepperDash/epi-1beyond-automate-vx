<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ProjectType>ProgramLibrary</ProjectType>
		<TargetFramework>net8</TargetFramework>
		<RootNamespace>PepperDash.Essentials.Plugins</RootNamespace>
		<AssemblyName>PepperDash.Essentials.Plugins.1Beyond.Automate.Vx</AssemblyName>
		<Configurations>Debug;Release</Configurations>
		<Deterministic>false</Deterministic>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyTitle>PepperDash.Essentials.Plugins.1Beyond.Automate.Vx</AssemblyTitle>
		<Description>This software is a plugin designed to work as a part of PepperDash Essentials for Crestron control processors. This plugin allows for control of 1Beyond AutomateVX Camera server.</Description>
		<PackageId>PepperDash.Essentials.Plugins.1Beyond.Automate.Vx</PackageId>
		<PackageProjectUrl>https://github.com/PepperDash/epi-1beyond-automate-vx</PackageProjectUrl>
		<PackageTags>crestron 4series essentials plugin 1beyond automatevx</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Crestron.SimplSharp.SDK.ProgramLibrary" Version="2.21.128" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="PepperDashEssentials" Version="3.0.0-feat-routing-slot-online-sync.2">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
